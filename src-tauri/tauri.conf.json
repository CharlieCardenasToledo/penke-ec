{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penké EC",
  "version": "1.0.4",
  "identifier": "ec.penke.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Penké EC — Firma Digital Auténtica",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/firmaec-backend.jar": "."
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQTZBNUM2NEIyOUEwOTMKUldTVG9DbEx4cVdtazVkeE4wMG9xaUkreDlHSm5DZS9DVWV5QmM2RFpZUEJuWlhpYmE3MlRjR1gK",
      "endpoints": [
        "https://github.com/CharlieCardenasToledo/penke-ec/releases/latest/download/latest.json"
      ]
    }
  }
}
